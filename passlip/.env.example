# Database connection used by passlip/dbh.php
DB_HOST=127.0.0.1
DB_USER=your_database_user
DB_PASS=your_database_password
DB_NAME=my_data

# Cloudflare Turnstile production widget
TURNSTILE_SITE_KEY=your_production_site_key
TURNSTILE_SECRET_KEY=your_production_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=gso.etracker.tagbilaran.gov.ph

# Local development only: use Cloudflare's official test credentials in passlip/.env.
# The application rejects these credentials automatically on non-local hostnames.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
